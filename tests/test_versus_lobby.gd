extends "res://tests/test_input.gd"

## Reuses the isolated input-event helpers, but has its own deferred run.
const LobbyModel = preload("res://scripts/VersusLobbyState.gd")

func release_pads() -> void:
	for device in [6, 9]:
		for index in [JOY_BUTTON_A, JOY_BUTTON_B, JOY_BUTTON_START, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT]:
			button(device, index, false)
		axis(device, JOY_AXIS_LEFT_X, 0)

func run() -> void:
	InputMap.load_from_project_settings()
	InputSettings.config_path = "res://.godot/versus-lobby-test.cfg"
	DirAccess.remove_absolute(InputSettings.config_path)
	InputSettings.ensure_loaded()
	defaults()
	var model = LobbyModel.new()
	model.open([0, 1])
	check(model.players[0] != model.players[1], "players own separate mutable state objects")
	check(model.players[0].device_id == 6 and model.players[1].device_id == 9, "nonconsecutive device IDs route to their assigned player")
	check(not model.can_start_game(), "unready lobby cannot start")
	check(not model.select_character(0, 1), "occupied character is rejected rather than changing the other player")
	check(model.players[1].selected_character == 1, "rejected selection preserves other player")
	check(model.cycle_character(0, 1) and model.players[0].selected_character == 2, "cycle skips occupied character")
	check(model.players[1].selected_character == 1, "1P cycle leaves 2P selection untouched")
	model.select_character(1, 4)
	check(model.players[0].selected_character == 2, "2P direct selection leaves 1P untouched")
	model.ready_player(0)
	check(model.players[0].is_character_confirmed and model.players[0].is_ready, "confirm and ready are stored on the individual player")
	check(not model.can_start_game(), "one ready player cannot start")
	model.cycle_character(1, 1)
	check(model.players[0].is_ready, "2P can keep choosing without unreadying 1P")
	model.ready_player(1)
	check(model.can_start_game(), "both valid ready players enable start")
	model.cancel_player(1)
	check(not model.can_start_game() and model.players[0].is_ready, "2P cancel disables start while preserving 1P ready")
	model.ready_player(1)
	model.cycle_character(1, -1)
	check(not model.players[1].is_ready and not model.players[1].is_character_confirmed, "editing a ready character clears only its owner's confirmation")
	check(model.players[0].is_ready, "editing ready 2P never clears 1P")
	model.ready_player(1)
	InputSettings.notify_joy_connection(6, false)
	model.refresh_routes()
	check(model.players[0].device_id == -1 and model.players[1].device_id == 9, "disconnect never steals the remaining player's pad")
	check(not model.players[0].is_ready and model.players[1].is_ready, "disconnect invalidates affected player's readiness only")
	InputSettings.set_device_mode("p1", InputSettings.MODE_GAMEPAD)
	model.refresh_routes()
	check(not model.ready_player(0) and not model.can_start_game(), "disconnected gamepad-only player cannot ready through silent keyboard fallback")
	InputSettings.notify_joy_connection(6, true)
	model.refresh_routes()
	check(model.players[0].device_id == 6 and not model.players[0].is_ready, "reconnect restores device but requires fresh ready")
	model.ready_player(0)
	check(model.players[1].is_ready, "reconnecting and readying 1P preserves 2P")
	InputSettings.bind_pad("p1", "skill", {"type": "button", "index": JOY_BUTTON_Y})
	model.refresh_routes()
	check(not model.players[0].is_ready and model.players[1].is_ready, "1P binding changes invalidate only 1P readiness")
	model.ready_player(0)
	var characters: Array = model.begin_game()
	check(characters.size() == 2, "central start gate accepts valid ready pair")
	check(model.begin_game().is_empty(), "start lock rejects duplicate initialization")
	model.close()
	check(not model.active and not model.players[0].is_ready and not model.players[1].is_ready, "leaving clears both ready states")
	defaults()
	main = load("res://main.tscn").instantiate()
	root.add_child(main)
	await process_frame
	main.set_process(false)
	main.set_physics_process(false)
	main.menu.set_process(false)
	main.overlay.set_process(false)
	var lobby = main.menu.versus_lobby
	lobby.set_process(false)
	main.menu.mode_index = 2
	main.menu._open_character()
	check(lobby.visible and lobby.model.active, "versus menu opens new lobby scene")
	check(lobby.panels[0] != lobby.panels[1] and lobby.panels[0].choice != lobby.panels[1].choice, "preview nodes and their player references are independent")
	check(lobby.model.players[0].selected_character == 0 and lobby.model.players[1].selected_character == 1, "fresh lobby starts with distinct existing characters")
	main._on_menu_start("versus", "xiaonuo", "axiu")
	check(main.state == main.State.MENU and main.world == null, "Main rejects bypassing lobby start authorization")
	button(6, JOY_BUTTON_DPAD_RIGHT, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[0].selected_character == 2 and lobby.model.players[1].selected_character == 1, "actual 1P device event changes only 1P preview state")
	main.menu._process_nav(0.016)
	check(main.menu.player == 0 and main.menu.mode_index == 2, "aggregate menu navigation cannot also process lobby input")
	lobby.process_inputs(0.1)
	check(lobby.model.players[0].selected_character == 2, "held direction does not repeat before delay")
	lobby.process_inputs(0.36)
	check(lobby.model.players[0].selected_character == 3, "held direction repeats for its own player after delay")
	release_pads()
	lobby.process_inputs(0.016)
	button(9, JOY_BUTTON_DPAD_RIGHT, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[1].selected_character == 2 and lobby.model.players[0].selected_character == 3, "actual 2P event changes only 2P")
	release_pads()
	lobby.process_inputs(0.016)
	button(6, JOY_BUTTON_DPAD_LEFT, true)
	button(9, JOY_BUTTON_DPAD_RIGHT, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[0].selected_character == 1 and lobby.model.players[1].selected_character == 3, "simultaneous device directions are both processed without shared focus")
	release_pads()
	lobby.process_inputs(0.016)
	button(9, JOY_BUTTON_A, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[1].is_ready and not lobby.model.players[0].is_ready and main.world == null, "2P confirm cannot ready 1P or start alone")
	release_pads()
	lobby.process_inputs(0.016)
	button(9, JOY_BUTTON_B, true)
	lobby.process_inputs(0.016)
	check(not lobby.model.players[1].is_ready and lobby.model.active, "2P B cancels only its ready state and stays in lobby")
	release_pads()
	lobby.process_inputs(0.016)
	button(6, JOY_BUTTON_START, true)
	lobby.process_inputs(0.016)
	check(main.world == null and not lobby.model.game_starting, "Start cannot bypass missing readiness")
	release_pads()
	lobby.process_inputs(0.016)
	button(6, JOY_BUTTON_A, true)
	lobby.process_inputs(0.016)
	main.menu._on_joy_connection_changed(6, false)
	check(not lobby.model.players[0].is_ready and lobby.model.players[1].device_id == 9, "connection signal immediately cancels affected player's ready")
	main.menu._on_joy_connection_changed(6, true)
	lobby.process_inputs(0.016)
	check(not lobby.model.players[0].is_ready, "held A during reconnect cannot silently re-ready")
	release_pads()
	lobby.process_inputs(0.016)
	axis(6, JOY_AXIS_LEFT_X, 0.1)
	var index_before: int = lobby.model.players[0].selected_character
	lobby.process_inputs(0.016)
	check(lobby.model.players[0].selected_character == index_before, "lobby analog drift obeys deadzone")
	axis(6, JOY_AXIS_LEFT_X, 0)
	lobby.process_inputs(0.016)
	var starts: Array = []
	main.menu.start_requested.connect(func(mode, c1, c2): starts.append([mode, c1, c2]))
	button(6, JOY_BUTTON_A, true)
	button(9, JOY_BUTTON_A, true)
	lobby.process_inputs(0.016)
	check(lobby.model.can_start_game() and starts.is_empty(), "simultaneous first confirms ready both but do not bypass explicit Start")
	lobby.visible = false
	lobby.request_start()
	check(starts.is_empty(), "hidden lobby cannot start through stale UI callbacks")
	lobby.visible = true
	lobby.process_inputs(0.5)
	check(starts.is_empty(), "holding both confirm buttons cannot start")
	var expected := [Cfg.CHAR_IDS[lobby.model.players[0].selected_character], Cfg.CHAR_IDS[lobby.model.players[1].selected_character]]
	release_pads()
	lobby.process_inputs(0.016)
	button(6, JOY_BUTTON_START, true)
	button(9, JOY_BUTTON_START, true)
	lobby.process_inputs(0.016)
	lobby.request_start()
	check(starts.size() == 1 and main.state == main.State.PLAY, "two simultaneous Start events initialize exactly one game")
	check(main.world.players[0].asset_id == expected[0] and main.world.players[1].asset_id == expected[1], "actual game receives each player's selected character in order")
	var old_selection: int = lobby.model.players[0].selected_character
	button(6, JOY_BUTTON_DPAD_RIGHT, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[0].selected_character == old_selection, "old lobby cannot receive gameplay input after start")
	release_pads()
	main._to_menu()
	var connection_count: int = lobby.start_requested.get_connections().size()
	for repeat in 4:
		main.menu.mode_index = 2
		main.menu._open_character()
		check(not lobby.model.game_starting and not lobby.model.players[0].is_ready and not lobby.model.players[1].is_ready, "reentry %d has no old ready/start lock" % repeat)
		main.menu._back_to_mode()
	check(lobby.start_requested.get_connections().size() == connection_count, "reentry does not duplicate signal connections")
	button(6, JOY_BUTTON_A, true)
	lobby.process_inputs(0.016)
	check(not lobby.model.active and not lobby.model.players[0].is_ready, "closed lobby ignores input")
	release_pads()
	defaults()
	InputSettings.set_device_mode("p1", InputSettings.MODE_KEYBOARD)
	InputSettings.set_device_mode("p2", InputSettings.MODE_KEYBOARD)
	main.menu.mode_index = 2
	main.menu._open_character()
	key(KEY_RIGHT, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[0].selected_character == 2 and lobby.model.players[1].selected_character == 1, "keyboard arrows belong only to 1P")
	key(KEY_RIGHT, false)
	lobby.process_inputs(0.016)
	key(KEY_D, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[1].selected_character == 3 and lobby.model.players[0].selected_character == 2, "keyboard WASD belong only to 2P")
	key(KEY_D, false)
	lobby.process_inputs(0.016)
	key(KEY_ENTER, true)
	lobby.process_inputs(0.016)
	check(lobby.model.players[0].is_ready and not lobby.model.players[1].is_ready, "Enter readies keyboard 1P only")
	key(KEY_ENTER, false)
	lobby.process_inputs(0.016)
	key(KEY_SPACE, true)
	lobby.process_inputs(0.016)
	check(lobby.model.can_start_game(), "two keyboard players can ready independently")
	key(KEY_SPACE, false)
	lobby.process_inputs(0.016)
	key(KEY_F, true)
	lobby.process_inputs(0.016)
	check(not lobby.model.can_start_game() and lobby.model.players[0].is_ready, "keyboard 2P cancel preserves keyboard 1P ready")
	key(KEY_F, false)
	main.menu._back_to_mode()
	main.queue_free()
	await process_frame
	DirAccess.remove_absolute(InputSettings.config_path)
	print("LOBBY_CHECKS=%d FAILURES=%d" % [checks, failures])
	quit(0 if failures == 0 else 1)
