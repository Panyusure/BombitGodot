# ── Godot 4+ ─────────────────────────────────────────────────────────────
.godot/
/android/
*.translation

# ── 导出产物 / 本地构建（体积大，不入库）─────────────────────────────────
build/
dist/
export/

# ── 第三方版权字体（归属 Microsoft / Monotype，不入库）───────────────────
