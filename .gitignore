assets/fonts/

# ── 运行时会话 / 回放数据 ────────────────────────────────────────────────
.bombit/

# ── 编辑器 / IDE ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── 操作系统杂项 ─────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Python 工具缓存 ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# 选角海报原始素材（40MB 的宣发图，用 tools_prepare_posters.py 生成 assets/characters/poster/）
高清海报/
